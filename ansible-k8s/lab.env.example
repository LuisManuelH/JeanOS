# Copiar a lab.env y editar (NO subir lab.env con tokens a Git):
#   cp lab.env.example lab.env
#
# Usado por: deploy-semana4.sh

# Repo GitHub público con app/ y k8s/ (demo del curso o tu fork)
GITHUB_REPO_URL=https://github.com/aliothosa/page-public-demo

# Imagen que Kaniko construye y publica (sin prefijo docker.io en el valor)
DOCKER_IMAGE=emmanuelmal2/semana4-landing:v1

# Usuario Docker Hub (para el Secret tekton)
DOCKER_USERNAME=emmanuelmal2

# Nombre del PipelineRun (cambiar a run-2, run-3... en cada re-ejecución)
PIPELINE_RUN_NAME=build-and-deploy-run-1

# ArgoCD UI (usuario siempre admin). Por defecto igual que Grafana en el lab.
ARGOCD_ADMIN_PASSWORD=jeanos2026
