# Copiar y editar (NO subir redeploy.env a Git):
#   cp redeploy.env.example redeploy.env
#
# Redeploy rápido tras cambios en backend, frontend, seed SQL y manifests.
# Pensado para cluster con Semana 4 ya aplicada (Tekton + ArgoCD).

# --- Rutas (opcional; el script las infiere si se omiten) ---
# REPO_ROOT=/home/aliothosa/Projects/JeanOS
# REDEPLOY_ENV=/home/aliothosa/Projects/JeanOS/ansible-k8s/redeploy.env

# --- Kubernetes ---
K8S_NAMESPACE=jeanos-shop
POSTGRES_POD=postgres-0
POSTGRES_USER=jeanosadmin
POSTGRES_DB=jeanosdb

# --- Imágenes (deben coincidir con backend/frontend Deployment y Tekton) ---
REGISTRY=docker.io/aliothosa
IMAGE_TAG=v1
DOCKER_BACKEND_IMAGE=jeanos-backend
DOCKER_FRONTEND_IMAGE=jeanos-frontend

# --- Pasos del redeploy (true/false) ---
BUILD_IMAGES=true
PUSH_IMAGES=true
RUN_SEED=true
APPLY_MANIFESTS=true
RESTART_DEPLOYMENTS=true
WAIT_ROLLOUT=true
RUN_SMOKE_TESTS=true
SHOW_INIT_LOGS=true

# --- Semana 4 / GitOps ---
# Si ArgoCD auto-sync está activo, un apply local puede revertirse al estado del repo remoto.
# Opciones: hacer git push de manifests, o pausar sync temporalmente:
PAUSE_ARGOCD_SYNC=false
ARGOCD_APP_NAME=jeanos-shop-gitops
ARGOCD_NAMESPACE=argocd

# --- Pruebas smoke (compare usa IDs de GPU del seed; ajusta si cambiaste datos) ---
COMPARE_ID_1=1
COMPARE_ID_2=2
PRODUCTS_CLASS_FILTER=gpu
FRONTEND_NODE_PORT=30080
# NODE_IP=192.168.1.10
